rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'plan',
          'subscriptionStatus',
          'emailVerified',
          'onboardingStatus',
          'billingProvider',
          'billingCustomerId',
          'billingPriceId',
          'billingCurrentPeriodEnd',
          'createdAt',
          'updatedAt',
          'lastLoginAt',
          'locale',
          'theme',
          'limits',
          'usageCurrentPeriod'
        ])
        && request.resource.data.plan == 'free'
        && request.resource.data.subscriptionStatus == 'none'
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.onboardingStatus == (
          request.auth.token.email_verified == true
            ? 'active'
            : 'email_verification_pending'
        )
        && request.resource.data.billingProvider == 'none'
        && request.resource.data.billingCustomerId == ''
        && request.resource.data.billingPriceId == ''
        && request.resource.data.billingCurrentPeriodEnd == null
        && request.resource.data.limits.maxBooks == 2
        && request.resource.data.limits.maxStorageBytes == 20 * 1024 * 1024
        && request.resource.data.limits.maxFileBytes == 20 * 1024 * 1024
        && request.resource.data.limits.monthlyMessages == 20
        && request.resource.data.limits.monthlyIngestions == 2
        && request.resource.data.usageCurrentPeriod.messages == 0
        && request.resource.data.usageCurrentPeriod.ingestions == 0
        && request.resource.data.usageCurrentPeriod.storageBytes == 0
        && request.resource.data.usageCurrentPeriod.books == 0;
      allow read: if owns(userId);
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'locale',
          'theme',
          'emailVerified',
          'onboardingStatus',
          'lastLoginAt',
          'updatedAt'
        ])
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.billingProvider == resource.data.billingProvider
        && request.resource.data.billingCustomerId == resource.data.billingCustomerId
        && request.resource.data.billingPriceId == resource.data.billingPriceId
        && request.resource.data.billingCurrentPeriodEnd == resource.data.billingCurrentPeriodEnd
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.onboardingStatus == (
          request.auth.token.email_verified == true
            ? 'active'
            : 'email_verification_pending'
        )
        && request.resource.data.limits == resource.data.limits
        && request.resource.data.usageCurrentPeriod == resource.data.usageCurrentPeriod;
      allow delete: if false;

      match /readerSettings/{bookId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.keys().hasOnly([
            'userId',
            'bookId',
            'lastPage',
            'bookmarks',
            'highlights',
            'updatedAt'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.bookId == bookId
          && (!('lastPage' in request.resource.data)
            || request.resource.data.lastPage is int)
          && (!('bookmarks' in request.resource.data)
            || request.resource.data.bookmarks is list)
          && (!('highlights' in request.resource.data)
            || request.resource.data.highlights is map);
        allow delete: if owns(userId);
      }
    }

    match /books/{bookId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /ingestionJobs/{jobId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /bookChunks/{chunkId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /bookSections/{sectionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /bookPages/{pageId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /bookPageText/{pageId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /bookInlineMedia/{mediaId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /articleDrafts/{draftId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /articleVersions/{versionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /userSessions/{sessionId} {
      allow read, write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && resource.data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
